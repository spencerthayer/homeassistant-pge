// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/go .
{
    "name": "homeassistant-pge",
    
    // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
    "image": "mcr.microsoft.com/devcontainers/python:3-3.14-trixie",

    // Features to add to the dev container. More info: https://containers.dev/features.
    "features": {
        "ghcr.io/devcontainers-extra/features/prek:1": {},
        "ghcr.io/devcontainers/features/node:2": {
            "version": "lts"
        }
    },

    "initializeCommand": [".devcontainer/initialize"],
    "runArgs": [
        "--env-file",
        "${localWorkspaceFolder}/.env",
        "-v",
        "/dev/null:/workspaces/homeassistant-pge/.env",
        "--add-host=host.docker.internal:host-gateway"
    ],

    // Use 'postCreateCommand' to run commands after the container is created.
    "postCreateCommand": ".devcontainer/post-create.sh",
    "forwardPorts": [
        8123
    ],

    "portsAttributes": {
        "8123": {
            "label": "Home Assistant"
        }
    },

    // Configure tool-specific properties.
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "timonwong.shellcheck",
                "charliermarsh.ruff",
                "tamasfe.even-better-toml"
            ],
            "settings": {
                "files.exclude": {
                    ".env": true
                }
            }
        }
    }
    // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
    // "remoteUser": "root"
}